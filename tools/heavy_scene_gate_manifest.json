  "policy": {
    "kind": "relative-baseline-preservation",
    "lowerIsBetter": [
      { "metric": "aggregate.mae", "relativeMargin": 0.01, "absoluteMargin": 0.005 },
      { "metric": "focus.mae", "relativeMargin": 0.01, "absoluteMargin": 0.02 },
      { "metric": "local.worstTileMae", "relativeMargin": 0.01, "absoluteMargin": 0.25 },
      { "metric": "foreground.falsePositiveAreaRatio", "relativeMargin": 0.02, "absoluteMargin": 0.002 },
      { "metric": "foreground.missingAreaRatio", "relativeMargin": 0.02, "absoluteMargin": 0.002 },
      { "metric": "boundary.unmatchedP95Px", "relativeMargin": 0.03, "absoluteMargin": 0.5 },
      { "metric": "temporal.flickerExcessMae", "relativeMargin": 0.03, "absoluteMargin": 0.02 }
    ],
    "higherIsBetter": [
      { "metric": "edge.meanF1", "relativeMargin": 0.03, "absoluteMargin": 0.02 }
    ],
    "contour": [
      { "field": "cardinalExtentErrorPx", "statistic": "p95", "relativeMargin": 0.03, "absoluteMargin": 0.5 },
      { "field": "cardinalExtentErrorPx", "statistic": "maximum", "relativeMargin": 0.03, "absoluteMargin": 0.75 },
      { "field": "outwardCardinalErrorPx", "statistic": "p95", "relativeMargin": 0.03, "absoluteMargin": 0.5 },
      { "field": "outwardCardinalErrorPx", "statistic": "maximum", "relativeMargin": 0.03, "absoluteMargin": 0.75 }
    ],
    "worstPerFrameEdgeF1Delta": -0.03,
    "zeroCountMetrics": [
      "tracking.trackMissCount",
      "tracking.identitySwitchProxyEvents"
    ]
  },
  "interpretation": {
    "pass": "The candidate preserves the release baseline within the frozen margins on every blocking fixture.",
    "notClaimed": "A pass is not an absolute claim that v7s reconstructs heavy scenes well. Diagnostic stress failures remain visible in the report and are future model-quality targets."
